  "openapi": "3.1.0",
  "paths": {
    "/api/v1/companies/{symbol}": {
      "get": {
        "operationId": "company_api_v1_companies__symbol__get",
        "parameters": [
          {
            "in": "path",
            "name": "symbol",
            "required": true,
            "schema": {
              "maxLength": 20,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9^][A-Za-z0-9^.\\-]*$",
              "title": "Symbol",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "bars",
            "required": false,
            "schema": {
              "default": 252,
              "maximum": 1000,
              "minimum": 1,
              "title": "Bars",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CompanyResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Modo no permitido"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Empresa no encontrada"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Datos cambiados"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Consulta no válida"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Error interno"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Datos no disponibles"
          }
        },
        "summary": "Company",
        "tags": [
          "market"
        ]
      }
    },
